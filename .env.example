# ==============================================================================
# Minecraft Universal Server Manager Configuration
# ==============================================================================

# Server Web Interface Binding
PORT=5000
HOST=0.0.0.0

# Base directory where Minecraft data, worlds, and properties reside
MINECRAFT_BASE_DIR=./data

# Optional: Path to custom Bedrock server binary (defaults to bedrock_server in MINECRAFT_BASE_DIR)
# MC_BEDROCK_BIN=/path/to/bedrock_server

# Security: 4-digit PIN for dashboard control (empty or unset disables PIN gate)
ADMIN_PIN=

# Auto-start servers when the manager starts up (true / false)
MC_AUTO_START_BEDROCK=false
MC_AUTO_START_JAVA=false

# ==============================================================================
# Remote Host & Java Control via RCON (Optional)
# ==============================================================================
# Connect to a remote Java server (Vanilla, Paper, Forge, Fabric, etc.) via RCON
RCON_ADDR=
RCON_PASSWORD=
JAVA_SERVER_ADDR=

# ==============================================================================
# Nexus Mesh CLI Agent Fleet Tunneling (Optional)
# ==============================================================================
# Connects to a Nexus Mesh hub to tunnel remote server actions, console commands,
# and fetch hardware telemetry (CPU, RAM, thermals, uptime, gaming mode)
NEXUS_HUB_URL=
NEXUS_ADMIN_PIN=
# Optional: Specific node ID in the mesh (if unset, automatically discovers node running minecraft)
NEXUS_TARGET_NODE_ID=

