FROM ubuntu:24.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gpg \
    libssl3 \
    libcurl4 \
    unzip \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb noble main" \
      > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-25-jre \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY minecraft-server-manager /app/minecraft-server-manager
COPY static/ /app/static/
COPY templates/ /app/templates/
RUN chmod +x /app/minecraft-server-manager

WORKDIR /data

ENV PORT=5000
ENV HOST=0.0.0.0

EXPOSE 5000/tcp
EXPOSE 19132/tcp
EXPOSE 19132/udp
EXPOSE 19133/udp
EXPOSE 19132-19142/udp
EXPOSE 7551/udp
EXPOSE 25565/tcp

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5000/api/status || exit 1

ENTRYPOINT ["/app/minecraft-server-manager"]
